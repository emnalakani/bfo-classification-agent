# Copy this file to ".env" at the repository root and set your own API key.
# Settings of the reported experiments (see README, "Experimental settings").
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.anthropic.com/v1/
LLM_MODEL=claude-sonnet-5-5
# The client sends temperature 0; if the provider rejects the parameter, it is
# dropped and the provider default is used (recorded in each summary.json).
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4000
# Maximum number of corrections after a failed check (agent only).
TRACE_MAX_REPAIRS=2
